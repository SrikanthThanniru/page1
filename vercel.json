{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "includeFiles": "{includes/**,sparkle-haven-villa-east-hyderabad.php,assets/img/**,assets/video/**,assets/dev/**}"
    }
  },
  "routes": [
    { "src": "/includes/.*", "status": 403 },
    { "src": "/(router|sparkle-haven-villa-east-hyderabad)\\.php", "dest": "/api/index.php" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/api/index.php" }
  ]
}
